   <dc:creator>
    <rdf:Seq>
     <rdf:li>Marijana PantiÄ‡</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Beyond Mandatory Participation: A Classification of Non-Statutory Participatory Methods</rdf:li>
     <rdf:li xml:lang="en-US">Beyond Mandatory Participation: A Classification of Non-Statutory Participatory Methods</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>public participation; participation methods; participation approaches; functional taxonomy; planning phases</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Public participation is integral to contemporary planning and decision-making</rdf:li>
     <rdf:li xml:lang="en-US">Public participation is integral to contemporary planning and decision-making</rdf:li>
     <rdf:li xml:lang="x-default">yet knowledge of methods beyond formally prescribed procedures remains fragmented across the academic and practice-oriented literature. Terminological inconsistencies and overlapping concepts further complicate their identification and practical selection. This study develops a systematic framework for identifying</rdf:li>
     <rdf:li xml:lang="en-US">yet knowledge of methods beyond formally prescribed procedures remains fragmented across the academic and practice-oriented literature. Terminological inconsistencies and overlapping concepts further complicate their identification and practical selection. This study develops a systematic framework for identifying</rdf:li>
     <rdf:li xml:lang="x-default">classifying</rdf:li>
     <rdf:li xml:lang="en-US">classifying</rdf:li>
     <rdf:li xml:lang="x-default">and characterising non-statutory participatory methods and examines their relevance across spatial planning phases. An exploratory</rdf:li>
     <rdf:li xml:lang="en-US">and characterising non-statutory participatory methods and examines their relevance across spatial planning phases. An exploratory</rdf:li>
     <rdf:li xml:lang="x-default">scoping-oriented literature review</rdf:li>
     <rdf:li xml:lang="en-US">scoping-oriented literature review</rdf:li>
     <rdf:li xml:lang="x-default">combined with qualitative content analysis and conceptual synthesis</rdf:li>
     <rdf:li xml:lang="en-US">combined with qualitative content analysis and conceptual synthesis</rdf:li>
     <rdf:li xml:lang="x-default">examined 96 publications containing identifiable participatory methods. The initial 869 entries were conceptually consolidated by distinguishing methods from aliases</rdf:li>
     <rdf:li xml:lang="en-US">examined 96 publications containing identifiable participatory methods. The initial 869 entries were conceptually consolidated by distinguishing methods from aliases</rdf:li>
     <rdf:li xml:lang="x-default">variants</rdf:li>
     <rdf:li xml:lang="en-US">variants</rdf:li>
     <rdf:li xml:lang="x-default">methodologies</rdf:li>
     <rdf:li xml:lang="en-US">methodologies</rdf:li>
     <rdf:li xml:lang="x-default">and umbrella categories</rdf:li>
     <rdf:li xml:lang="en-US">and umbrella categories</rdf:li>
     <rdf:li xml:lang="x-default">resulting in 124 participatory methods</rdf:li>
     <rdf:li xml:lang="en-US">resulting in 124 participatory methods</rdf:li>
     <rdf:li xml:lang="x-default">76 aliases</rdf:li>
     <rdf:li xml:lang="en-US">76 aliases</rdf:li>
     <rdf:li xml:lang="x-default">128 variants</rdf:li>
     <rdf:li xml:lang="en-US">128 variants</rdf:li>
     <rdf:li xml:lang="x-default">and 12 methodologies. Based on their primary purpose</rdf:li>
     <rdf:li xml:lang="en-US">and 12 methodologies. Based on their primary purpose</rdf:li>
     <rdf:li xml:lang="x-default">methods were organised into ten functional categories</rdf:li>
     <rdf:li xml:lang="en-US">methods were organised into ten functional categories</rdf:li>
     <rdf:li xml:lang="x-default">while secondary functions captured their cross-functional applicability. Method characteristics and broader participatory approaches were additionally distinguished</rdf:li>
     <rdf:li xml:lang="en-US">while secondary functions captured their cross-functional applicability. Method characteristics and broader participatory approaches were additionally distinguished</rdf:li>
     <rdf:li xml:lang="x-default">and functional categories were mapped against seven spatial planning phases. The findings demonstrate that participatory methods are neither conceptually discrete nor restricted to a single function</rdf:li>
     <rdf:li xml:lang="en-US">and functional categories were mapped against seven spatial planning phases. The findings demonstrate that participatory methods are neither conceptually discrete nor restricted to a single function</rdf:li>
     <rdf:li xml:lang="x-default">but may extend across functional categories and planning phases. The framework makes the functional diversity and relationships among non-statutory participatory methods more explicit</rdf:li>
     <rdf:li xml:lang="en-US">but may extend across functional categories and planning phases. The framework makes the functional diversity and relationships among non-statutory participatory methods more explicit</rdf:li>
     <rdf:li xml:lang="x-default">providing a structured basis for their initial identification and comparison according to participatory purposes and potential relevance to different planning phases</rdf:li>
     <rdf:li xml:lang="en-US">providing a structured basis for their initial identification and comparison according to participatory purposes and potential relevance to different planning phases</rdf:li>
     <rdf:li xml:lang="x-default">rather than a comprehensive tool for context-specific method selection.</rdf:li>
     <rdf:li xml:lang="en-US">rather than a comprehensive tool for context-specific method selection.</rdf:li>
    </rdf:Alt>
   </dc:description>
